{
  "name": "ulshms",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hms/web",
    "build": "npm run build --workspace @hms/web",
    "typecheck": "npm run typecheck --workspace @hms/web",
    "test": "npm run test --workspace @hms/web",
    "test:integration": "node --env-file=apps/web/.env.local scripts/integration.mjs",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"apps/web/scripts/*.ts\" \"scripts/*.mjs\"",
    "db:migrate": "npm run db:migrate --workspace @hms/web",
    "admin:create": "npm run admin:create --workspace @hms/web"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
