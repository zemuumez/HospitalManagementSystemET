{
  "name": "ulshms",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @hms/web",
    "build": "npm run build --workspace @hms/web",
    "typecheck": "npm run typecheck --workspace @hms/web",
    "test": "npm run test --workspace @hms/web",
    "test:integration": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --integration",
    "test:connected": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"apps/web/scripts/*.ts\" \"scripts/*.mjs\"",
    "db:migrate": "npm run db:migrate --workspace @hms/web",
    "admin:create": "npm run admin:create --workspace @hms/web",
    "test:frontend": "node scripts/verify-frontend.mjs",
    "test:firebase": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --firebase",
    "test:recovery": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --recovery",
    "test:invitations": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --invitations",
    "test:operational": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --operational",
    "test:doctor": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --doctor-workspace",
    "test:settings": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --settings-workspace",
    "test:inventory": "node --env-file=apps/web/.env.local scripts/verify-connected-isolated.mjs --inventory-workspace"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "uuid": "11.1.1",
    "firebase-tools": {
      "chokidar": "4.0.3",
      "basic-ftp": "6.2.2",
      "@opentelemetry/core": "2.11.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "firebase-tools": "15.32.1",
    "prettier": "3.9.9"
  }
}
