APP_ENV=development
DATABASE_URL=postgresql://hms:hms_local_only@127.0.0.1:5433/hms
BETTER_AUTH_URL=http://127.0.0.1:3000
API_ADDR=127.0.0.1:8080
SMS_PROVIDER=capture
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@hms.local
# To enable actual operational SMS, configure Twilio explicitly:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Production requires APP_ENV=production, HTTPS auth and SMTP STARTTLS.

# Private upload directory; blank disables uploads. Production uploads require ClamAV.
HMS_ATTACHMENT_DIR=
# Loopback ClamAV INSTREAM endpoint, e.g. 127.0.0.1:3310; keep blank until installed.
HMS_CLAMAV_ADDRESS=
