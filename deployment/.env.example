# Production worksheet. Fill in a private copy or deployment secret manager.
# Never load this blank worksheet into the current development services.
APP_ENV=production
NODE_ENV=production
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GO_API_URL=
API_ADDR=127.0.0.1:8080

# Optional Firebase phone login: leave all blank until configured.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Production must not set FIREBASE_AUTH_EMULATOR_HOST or NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL.

# Operational SMS worker: blank credentials never enable a live sender.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# STARTTLS SMTP (port 587) supported by both web and worker.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_FROM=

# Reserved payment configuration: not yet consumed by a payment adapter.
# These entries alone do NOT enable online payments.
PAYMENT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
